{
  "name": "voice-chat-app",
  "version": "2.0.0",
  "description": "Discord-like Voice Chat Application with WebRTC",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.js",
    "electron:dev": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.voicechatapp.app",
    "productName": "So Mua VoiceChat",
    "copyright": "Copyright © 2026 So Mua VoiceChat",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "icon": "Icon.png",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "So Mua VoiceChat",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json",
      "!**/node_modules/**",
      "!dist/**",
      "!scripts/**",
      "!public/**",
      "!*.db",
      "!server.js",
      "!database.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "body-parser": "^2.2.2",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "fs-extra": "^11.3.3"
  }
}